#!/usr/bin/env bash
# kokoro-reader: install and manage the local Kokoro voice server used by the Kokoro Reader Chrome extension.
# Works on macOS (Apple Silicon and Intel) and Linux. Everything lives in ~/.kokoro-reader.
set -euo pipefail

VERSION="0.4.0"
KR_HOME="${KOKORO_READER_HOME:-$HOME/.kokoro-reader}"
SRC="$KR_HOME/Kokoro-FastAPI"
PORT="${KOKORO_PORT:-8880}"
LOG="$KR_HOME/server.log"
REPO_URL="https://github.com/remsky/Kokoro-FastAPI.git"
REPO_REF="3c0d616d75ad542a4ff87fa6a3026720888f809a"   # tested version
OS="$(uname -s)"; ARCH="$(uname -m)"
LABEL="com.kokoro-reader.server"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UNIT="$HOME/.config/systemd/user/kokoro-reader.service"

c() { if [ -t 1 ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi; }
say() { echo "$(c '38;5;166' '>') $*"; }
die() { echo "$(c 31 'Error:') $*" >&2; exit 1; }

# ---------- progress display ----------
# Long steps run in the background with a spinner, a timer and the latest line of their output,
# so it is obvious the installer is working and not stuck. Full output goes to $ILOG.
ILOG="$KR_HOME/install.log"
FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
STEPS=0; STEP_N=0; SOFT_FAIL=0

fmt_t() { printf '%d:%02d' $(($1 / 60)) $(($1 % 60)); }
last_line() {  # latest line of the install log, trimmed to $1 characters
  [ "$1" -gt 12 ] || return 0
  local l; l="$(tail -c 600 "$ILOG" 2>/dev/null | tr '\r' '\n' | tail -n 1 | tr -cd '[:print:]' | sed 's/^ *//' | cut -c1-"$1")"
  [ -n "$l" ] && printf '  %s' "$(c 2 "$l")"
  return 0
}
step_tag() { if [ "$STEPS" -gt 0 ]; then printf '[%d/%d] ' "$STEP_N" "$STEPS"; fi; }
step_skip() {  # step_skip "label": nothing to do for this step
  STEP_N=$((STEP_N + 1)); echo "$(c 32 '✓') $(step_tag)$1"
}
run_step() {  # run_step "label" command args...   (returns the command's exit status)
  local label="$1"; shift
  STEP_N=$((STEP_N + 1))
  local tag; tag="$(step_tag)"
  mkdir -p "$KR_HOME"; echo "=== $tag$label $(date)" >> "$ILOG"
  local start=$SECONDS pid rc=0 i=0
  "$@" >> "$ILOG" 2>&1 &
  pid=$!
  if [ -t 1 ]; then
    trap 'kill "$pid" 2>/dev/null; printf "\033[?25h\n"; exit 130' INT TERM
    printf '\033[?25l'
    local cols; cols="$(tput cols 2>/dev/null || echo 80)"
    while kill -0 "$pid" 2>/dev/null; do
      local el=$((SECONDS - start)) t; t="$(fmt_t $((SECONDS - start)))"
      local used=$((${#tag} + ${#label} + ${#t} + 5))
      printf '\r\033[K%s %s%s  %s%s' "$(c '38;5;166' "${FRAMES[i % 10]}")" "$tag" "$label" "$t" "$(last_line $((cols - used)))"
      i=$((i + 1)); sleep 0.12
    done
    printf '\r\033[K\033[?25h'
    trap - INT TERM
  else
    local tick=0
    echo "... $tag$label"
    while kill -0 "$pid" 2>/dev/null; do
      sleep 1; tick=$((tick + 1))
      [ $((tick % 30)) -eq 0 ] && echo "    still working ($(fmt_t $((SECONDS - start))))"
    done
  fi
  wait "$pid" || rc=$?
  local took; took="$(fmt_t $((SECONDS - start)))"
  if [ "$rc" -eq 0 ]; then
    echo "$(c 32 '✓') $tag$label $(c 2 "($took)")"
  elif [ "$SOFT_FAIL" = 1 ]; then
    echo "$(c 33 '!') $tag$label $(c 2 "(not finished after $took)")"
  else
    echo "$(c 31 '✗') $tag$label failed after $took" >&2
    echo "Last lines of the log:" >&2
    tail -n 15 "$ILOG" | sed 's/^/    /' >&2
    echo "Full log: $ILOG" >&2
  fi
  return "$rc"
}

# the step bodies (run in the background by run_step)
step_uv()    { curl -LsSf https://astral.sh/uv/install.sh | sh; }
step_fetch() {
  [ -d "$SRC/.git" ] || git clone --progress "$REPO_URL" "$SRC"
  git -C "$SRC" fetch origin "$REPO_REF" 2>/dev/null || git -C "$SRC" fetch origin
  git -C "$SRC" checkout "$REPO_REF"
}
step_deps()  { cd "$SRC"; "$UV" venv --python 3.12 || "$UV" venv; "$UV" pip install -e ".$EXTRA"; }
step_model() { cd "$SRC"; USE_GPU=$USE_GPU PYTHONPATH="$SRC:$SRC/api" "$UV" run --no-sync python docker/scripts/download_model.py --output api/src/models/v1_0; }

find_uv() {
  for p in "$(command -v uv 2>/dev/null || true)" "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
    [ -n "$p" ] && [ -x "$p" ] && { echo "$p"; return; }
  done
}

device_setup() {
  # sets EXTRA, USE_GPU, DEVICE_TYPE
  if [ "$OS" = "Darwin" ] && [ "$ARCH" = "arm64" ]; then EXTRA=""; USE_GPU=true; DEVICE_TYPE=mps
  elif [ "$OS" = "Linux" ] && command -v nvidia-smi >/dev/null 2>&1; then EXTRA="[gpu]"; USE_GPU=true; DEVICE_TYPE=cuda
  else EXTRA="[cpu]"; USE_GPU=false; DEVICE_TYPE=cpu; fi
}

write_runner() {
  device_setup
  local UV; UV="$(find_uv)"
  cat > "$KR_HOME/run-server.sh" <<RUN
#!/usr/bin/env bash
cd "$SRC"
export PATH="$(dirname "$UV"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:\$HOME/.local/bin"
export USE_GPU=$USE_GPU
export DEVICE_TYPE=$DEVICE_TYPE
export PYTHONPATH="$SRC:$SRC/api"
export MODEL_DIR=src/models
export VOICES_DIR=src/voices/v1_0
export WEB_PLAYER_PATH="$SRC/web"
export PYTORCH_ENABLE_MPS_FALLBACK=1
exec "$UV" run --no-sync uvicorn api.src.main:app --host 127.0.0.1 --port $PORT
RUN
  chmod +x "$KR_HOME/run-server.sh"
}

cmd_install() {
  local AUTOSTART=1
  for a in "$@"; do [ "$a" = "--no-autostart" ] && AUTOSTART=0; done
  say "Kokoro Reader server installer v$VERSION ($OS $ARCH)"
  echo "  This takes about 5 to 10 minutes the first time. The spinner and timer show it is working."
  echo "  Nothing is stuck unless a step says failed. Full log: $ILOG"
  echo
  command -v git >/dev/null 2>&1 || die "git is required. macOS: run xcode-select --install. Linux: install git with your package manager."
  mkdir -p "$KR_HOME"
  STEPS=6; STEP_N=0; [ "$AUTOSTART" = 1 ] || STEPS=4

  UV="$(find_uv)"
  if [ -z "$UV" ]; then
    run_step "Installing uv (fast Python manager)" step_uv || exit 1
    UV="$(find_uv)"; [ -n "$UV" ] || die "uv install failed. See https://docs.astral.sh/uv/"
  else
    step_skip "uv is already installed"
  fi

  if [ "$OS" = "Linux" ] && ! command -v espeak-ng >/dev/null 2>&1; then
    say "Note: install espeak-ng for best pronunciation (Debian/Ubuntu: sudo apt install espeak-ng)."
  fi

  run_step "Downloading the Kokoro server" step_fetch || exit 1

  device_setup
  run_step "Installing Python and dependencies ($DEVICE_TYPE), the slow step" step_deps || exit 1
  run_step "Downloading the voice model (about 330 MB)" step_model || exit 1
  write_runner
  if [ "$AUTOSTART" = 1 ]; then run_step "Setting up start at login" cmd_autostart on || exit 1; else say "Skipped autostart. Run: kokoro-reader start"; fi
  mkdir -p "$HOME/.local/bin"
  [ -f "$0" ] && [ "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" != "$HOME/.local/bin/kokoro-reader" ] && cp "$0" "$HOME/.local/bin/kokoro-reader" && chmod +x "$HOME/.local/bin/kokoro-reader" || true
  if [ "$AUTOSTART" = 1 ]; then
    SOFT_FAIL=1
    if run_step "Starting the voice server (loading the model into memory)" wait_ready; then
      SOFT_FAIL=0; echo; say "$(c 32 'Done.') Voice server is running at http://localhost:$PORT (open http://localhost:$PORT/web to check)"
    else
      SOFT_FAIL=0; echo; say "Server is still warming up. Check with: kokoro-reader status"
    fi
  else
    echo; say "$(c 32 'Done.') Start the server with: kokoro-reader start"
  fi
  echo
  echo "Next: load the extension in Chrome (chrome://extensions, Developer mode, Load unpacked) and open any page or Google Doc."
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "Tip: add \$HOME/.local/bin to your PATH to use the kokoro-reader command anywhere.";; esac
}

wait_ready() {
  for _ in $(seq 1 90); do
    curl -fs "http://127.0.0.1:$PORT/v1/audio/voices" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

cmd_autostart() {
  [ -x "$KR_HOME/run-server.sh" ] || write_runner
  case "${1:-on}" in
    on)
      if [ "$OS" = "Darwin" ]; then
        mkdir -p "$HOME/Library/LaunchAgents"
        cat > "$PLIST" <<P
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>$LABEL</string>
 <key>ProgramArguments</key><array><string>$KR_HOME/run-server.sh</string></array>
 <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
 <key>StandardOutPath</key><string>$LOG</string><key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
P
        launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$PLIST"
        launchctl kickstart -k "gui/$(id -u)/$LABEL"
      else
        mkdir -p "$(dirname "$UNIT")"
        cat > "$UNIT" <<U
[Unit]
Description=Kokoro Reader voice server
[Service]
ExecStart=$KR_HOME/run-server.sh
Restart=always
StandardOutput=append:$LOG
StandardError=append:$LOG
[Install]
WantedBy=default.target
U
        systemctl --user daemon-reload && systemctl --user enable --now kokoro-reader.service
      fi
      say "Autostart is on. The server starts at login and restarts if it stops." ;;
    off)
      if [ "$OS" = "Darwin" ]; then launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true; rm -f "$PLIST"
      else systemctl --user disable --now kokoro-reader.service 2>/dev/null || true; rm -f "$UNIT"; fi
      say "Autostart is off." ;;
    *) die "Usage: kokoro-reader autostart on|off" ;;
  esac
}

cmd_start() {
  [ -x "$KR_HOME/run-server.sh" ] || die "Not installed yet. Run: kokoro-reader install"
  if [ "$OS" = "Darwin" ] && [ -f "$PLIST" ]; then launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true; launchctl kickstart -k "gui/$(id -u)/$LABEL"
  elif [ "$OS" = "Linux" ] && [ -f "$UNIT" ]; then systemctl --user start kokoro-reader.service
  else say "Running in the foreground. Press Ctrl+C to stop."; exec "$KR_HOME/run-server.sh"; fi
  SOFT_FAIL=1; STEPS=0
  if run_step "Waiting for the voice server" wait_ready; then say "Server running at http://localhost:$PORT"; else say "Still starting. Check: kokoro-reader logs"; fi
}

cmd_stop() {
  if [ "$OS" = "Darwin" ] && [ -f "$PLIST" ]; then launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  elif [ "$OS" = "Linux" ] && [ -f "$UNIT" ]; then systemctl --user stop kokoro-reader.service
  else pkill -f "uvicorn api.src.main:app.*--port $PORT" || true; fi
  say "Stopped. (Autostart will bring it back at next login. Turn off with: kokoro-reader autostart off)"
}

cmd_status() {
  if curl -fs "http://127.0.0.1:$PORT/v1/audio/voices" >/dev/null 2>&1; then
    local n; n="$(curl -fs "http://127.0.0.1:$PORT/v1/audio/voices" | tr ',' '\n' | grep -c '"' || true)"
    say "$(c 32 Running) at http://localhost:$PORT ($n voices)"
  else say "$(c 31 'Not running'). Start it with: kokoro-reader start"; fi
}

cmd_logs() { [ -f "$LOG" ] || die "No log yet."; exec tail -n 80 -f "$LOG"; }

cmd_update() {
  [ -d "$SRC/.git" ] || die "Not installed. Run: kokoro-reader install"
  say "Re-running install to pick up the tested server version..."; cmd_install "$@"
}

cmd_uninstall() {
  cmd_autostart off || true
  pkill -f "uvicorn api.src.main:app.*--port $PORT" 2>/dev/null || true
  rm -rf "$KR_HOME"; rm -f "$HOME/.local/bin/kokoro-reader"
  say "Removed $KR_HOME. The Chrome extension can be removed from chrome://extensions."
}

case "${1:-help}" in
  install) shift; cmd_install "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  autostart) shift; cmd_autostart "${1:-on}" ;;
  update) shift; cmd_update "$@" ;;
  uninstall) cmd_uninstall ;;
  version|--version|-v) echo "kokoro-reader $VERSION" ;;
  *) cat <<H
kokoro-reader $VERSION  (local Kokoro voice server for the Kokoro Reader extension)

  install [--no-autostart]   download the voice server and model, start it at login
  start | stop | restart     control the server
  status                     is it running?
  logs                       follow the server log
  autostart on|off           start at login
  update                     re-run install
  uninstall                  remove everything this tool installed
H
  ;;
esac
